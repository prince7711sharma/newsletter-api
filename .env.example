# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=student_counselling
USERS_COLLECTION=users

# ─── Groq AI ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama3-8b-8192

# ─── Resend (Email) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=RS Education <newsletter@yourdomain.com>
EMAIL_FROM_NAME=R.S Education

# ─── App ─────────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
BASE_URL=https://yourdomain.com   # Used in CTA & unsubscribe links

# ─── Scheduler ────────────────────────────────────────────────────────────────
# Cron: day_of_week=sun, hour=9, minute=0 → Every Sunday 9:00 AM IST
SCHEDULER_DAY_OF_WEEK=sun
SCHEDULER_HOUR=9
SCHEDULER_MINUTE=0

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=10    # API calls per minute per IP
EMAIL_BATCH_SIZE=10         # Users processed per batch
EMAIL_BATCH_DELAY=1.0       # Seconds to wait between batches

# ─── Retry Logic ──────────────────────────────────────────────────────────────
MAX_EMAIL_RETRIES=3
RETRY_DELAY=2.0
